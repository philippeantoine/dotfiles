{
  "cli_default_open_behavior": "existing_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 12,
  "buffer_font_features": {
    "calt": true
  },
  "tab_size": 2,
  "format_on_save": "on",
  "formatter": "prettier",
  "active_line_highlight": "none",
  "gutter": {
    "line_numbers": false,
    "folds": false
  },
  "scrollbar": {
    "show": "never"
  }
}
